# Client-safe Expo variables
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Legacy fallback only if needed:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# Base map. OpenFreeMap is the low-cost default for Sanad preview/production.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_MAP_PROVIDER=openfreemap
EXPO_PUBLIC_MAP_TILES_TOKEN=OPTIONAL_PUBLIC_MAP_TOKEN

# Supabase Edge Function secrets - NEVER prefix with EXPO_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=SET_IN_SUPABASE_SECRETS_ONLY
INTERNAL_FUNCTION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
SUPABASE_REPORT_FONT_URL=https://YOUR_TRUSTED_HOST/arabic-font.ttf

# Public release/legal URLs. Use real HTTPS pages before store submission.
EXPO_PUBLIC_PRIVACY_URL=https://YOUR_PUBLIC_PRIVACY_PAGE
EXPO_PUBLIC_TERMS_URL=https://YOUR_PUBLIC_TERMS_PAGE
EXPO_PUBLIC_SUPPORT_URL=https://YOUR_PUBLIC_SUPPORT_PAGE
